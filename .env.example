# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- MLflow ---
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=routewise-disruption

# --- Model registry ---
MODEL_STAGE=Staging

# --- DVC remote (fill in when a real remote is configured) ---
DVC_REMOTE_URL=

# --- External data sources (production mode only; leave blank in demo mode) ---
GTFS_SOURCE_URL=
WEATHER_API_KEY=
WEATHER_API_URL=

# --- Data mode: "demo" uses the synthetic dataset, "production" expects real GTFS/weather/delay data ---
DATA_MODE=demo
