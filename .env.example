# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- MLflow ---
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=RouteWise-Disruption-Prediction
REGISTERED_MODEL_NAME=RouteWise-Disruption-Model

# --- Model source: "production" or "candidate". No model is promoted to
# production yet (see Stage 5/6 findings) — using "candidate" + an
# explicit version is the only currently-working configuration. Switching
# this to "production" once a model is promoted requires no code change.
MODEL_SOURCE=candidate
MODEL_CANDIDATE_VERSION=4

# --- DVC remote (fill in when a real remote is configured) ---
DVC_REMOTE_URL=

# --- External data sources (production mode only; leave blank in demo mode) ---
GTFS_SOURCE_URL=
WEATHER_API_KEY=
WEATHER_API_URL=

# --- Data mode: "demo" uses the synthetic dataset, "production" expects real GTFS/weather/delay data ---
DATA_MODE=demo
