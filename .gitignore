# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Env / secrets ---
.env
*.local

# --- MLOps artifacts ---
mlruns/
mlartifacts/
.dvc/cache
.dvc/tmp
*.dvc.lock

# --- Data (large content tracked via DVC — see per-directory .gitignore
#     entries DVC generates on `dvc add`; git tracks only .dvc pointer
#     files and small human-readable metadata/reports/manifests) ---
data/external/*
!data/external/.gitkeep

# --- Frontend ---
dashboard/node_modules/
dashboard/dist/
dashboard/.vite/
dashboard/screenshots/

# --- Monitoring (Stage 9) — generated reports, not source ---
data/interim/monitoring/html_reports/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# --- Notebooks ---
.ipynb_checkpoints/
